# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Drizzle / Postgres (Supabase)
# Conexión directa, puerto 5432 — usada por drizzle-kit para migraciones.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxx.supabase.co:5432/postgres

# Conexión pooled vía PgBouncer, puerto 6543 — usada en runtime por la app.
DATABASE_URL_POOLED=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxx.supabase.co:6543/postgres

# Basic Auth de admin.tukios.com (admin.localhost en dev) -- alta interna de
# tiendas. Elegí un usuario/contraseña propios, no relacionados a ninguna
# cuenta real; esto NO es autenticación de usuarios de la app.
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=cambiar-esto
